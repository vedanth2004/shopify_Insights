# Supabase Database Connection
# Get this from Supabase Dashboard  Settings  Database  Connection String (Connection Pooling mode)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# JWT Secret for authentication tokens
JWT_SECRET="your-secret-key-change-in-production"

# Shopify API Credentials
# Get these from your Shopify Partner Dashboard  Apps  Your App
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Frontend URL (for CORS and Shopify host)
# Local: http://localhost:3000
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
SHOPIFY_HOST="localhost:3001"

# Server Configuration
PORT=3001
NODE_ENV=development
