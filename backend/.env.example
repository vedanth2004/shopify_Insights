# Render PostgreSQL Database Connection
# When deploying to Render, link the PostgreSQL database in the service settings
# Render will automatically set DATABASE_URL - no need to set it manually
# For local development, use your local PostgreSQL connection string:
DATABASE_URL="postgresql://user:password@localhost:5432/shopify_insights_db"

# JWT Secret for authentication tokens
JWT_SECRET="your-secret-key-change-in-production"

# Shopify API Credentials
# Get these from your Shopify Partner Dashboard  Apps  Your App
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"

# Frontend URL (for CORS and Shopify host)
# Local: http://localhost:3000
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
SHOPIFY_HOST="localhost:3001"

# Server Configuration
PORT=3001
NODE_ENV=development
